---
import { INQUIRY_STATUSES } from "../../lib/inquiries/schema";

interface Props {
  statusFilter?: string;
  userEmail?: string;
  counts?: Record<string, number>;
  section?: "inbox" | "articles";
}

const { statusFilter = "all", userEmail, counts = {}, section = "inbox" } = Astro.props;

const navItems: { id: string; label: string; href: string }[] = [
  { id: "all", label: "All", href: "/admin" },
  ...INQUIRY_STATUSES.map((s) => ({
    id: s,
    label: s.charAt(0).toUpperCase() + s.slice(1),
    href: `/admin?status=${s}`,
  })),
];

function isActive(id: string) {
  return section === "inbox" && statusFilter === id;
}

const initial = userEmail?.charAt(0).toUpperCase() ?? "A";
---

<div class="admin-app" data-admin-app>
  <aside class="admin-sidebar" aria-label="Admin navigation">
    <button
      type="button"
      class="admin-sidebar__collapse"
      data-sidebar-toggle
      aria-expanded="true"
      aria-label="Collapse sidebar"
    >
      <svg
        class="admin-sidebar__collapse-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="m14 8-4 4 4 4M10 8l-4 4 4 4"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div class="admin-sidebar__brand">
      <div class="admin-sidebar__brand-row">
        <a href="/admin" class="admin-sidebar__logo">
          <span class="admin-sidebar__logo-full">IDNWIRED</span>
          <span class="admin-sidebar__logo-short" aria-hidden="true">ID</span>
        </a>
      </div>
    </div>

    <nav class="admin-sidebar__nav">
      <p class="admin-sidebar__nav-label">Inbox</p>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["admin-sidebar__link", isActive(item.id) && "is-active"]}
                aria-current={isActive(item.id) ? "page" : undefined}
                title={item.label}
              >
                <span class="admin-sidebar__link-icon" aria-hidden="true">
                  {item.id === "all" && (
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                      <rect x="3" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                      <rect x="11" y="3" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                      <rect x="3" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                      <rect x="11" y="11" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}
                  {item.id === "new" && (
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                      <circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="1.5" />
                      <path d="M10 7v6M7 10h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.id === "contacted" && (
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                      <path
                        d="M4 6.5 10 11l6-4.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <rect x="3" y="5" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}
                  {item.id === "closed" && (
                    <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                      <path
                        d="M6.5 10.5 9 13l4.5-5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                      <circle cx="10" cy="10" r="6.5" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}
                </span>
                <span class="admin-sidebar__link-text">{item.label}</span>
                {
                  counts[item.id] !== undefined ? (
                    <span class="admin-sidebar__count">{counts[item.id]}</span>
                  ) : null
                }
              </a>
            </li>
          ))
        }
      </ul>

      <p class="admin-sidebar__nav-label">Content</p>
      <ul>
        <li>
          <a
            href="/admin/articles"
            class:list={["admin-sidebar__link", section === "articles" && "is-active"]}
            aria-current={section === "articles" ? "page" : undefined}
            title="Articles"
          >
            <span class="admin-sidebar__link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
                <path
                  d="M5 4.5h10A1.5 1.5 0 0 1 16.5 6v10A1.5 1.5 0 0 1 15 17.5H5A1.5 1.5 0 0 1 3.5 16V6A1.5 1.5 0 0 1 5 4.5Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path d="M6.5 8h7M6.5 11h7M6.5 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
            <span class="admin-sidebar__link-text">Articles</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="admin-sidebar__foot">
      <div class="admin-sidebar__foot-links">
        <a href="/api/admin/logout" class="admin-sidebar__signout">
          <span class="admin-sidebar__foot-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
              <path
                d="M8 5H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h4M12 10h6M15 7l3 3-3 3"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="admin-sidebar__foot-text">Sign out</span>
        </a>
      </div>
    </div>
  </aside>

  <div class="admin-main">
    <header class="admin-header">
      <div class="admin-header__start">
        <button
          type="button"
          class="admin-header__menu"
          data-sidebar-toggle
          aria-expanded="true"
          aria-label="Collapse sidebar"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 6h12M4 10h12M4 14h12" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
        <p class="admin-header__label">Campaign admin</p>
      </div>
      <div class="admin-header__end">
        <a class="admin-header__link" href="/" target="_blank" rel="noopener noreferrer">
          Website
        </a>
        {
          userEmail ? (
            <div class="admin-header__user" title={userEmail}>
              <span class="admin-header__avatar" aria-hidden="true">
                {initial}
              </span>
              <span class="admin-header__email">{userEmail}</span>
            </div>
          ) : null
        }
      </div>
    </header>
    <div class="admin-content">
      <slot />
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = "idnwired-admin-sidebar-collapsed";

  function setSidebarCollapsed(app: HTMLElement, collapsed: boolean) {
    app.classList.toggle("is-sidebar-collapsed", collapsed);
    document.querySelectorAll("[data-sidebar-toggle]").forEach((btn) => {
      btn.setAttribute("aria-expanded", String(!collapsed));
      btn.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
    });
  }

  function initSidebarToggle() {
    const app = document.querySelector("[data-admin-app]") as HTMLElement | null;
    if (!app || app.dataset.sidebarBound === "1") return;
    app.dataset.sidebarBound = "1";

    const saved = localStorage.getItem(STORAGE_KEY) === "1";
    setSidebarCollapsed(app, saved);

    document.querySelectorAll("[data-sidebar-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const collapsed = !app.classList.contains("is-sidebar-collapsed");
        setSidebarCollapsed(app, collapsed);
        localStorage.setItem(STORAGE_KEY, collapsed ? "1" : "0");
      });
    });
  }

  initSidebarToggle();
  document.addEventListener("astro:page-load", initSidebarToggle);
</script>
