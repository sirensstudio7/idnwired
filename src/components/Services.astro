---
import { agency } from "../data/creators";

const { kicker, headline, body, marqueeLabel, marqueeRows } = agency.whyIndonesia;
const [lead, quote, note] = body;

const insights = [
  {
    id: "01",
    title: "Lives on screens",
    body: lead,
    featured: true,
    metrics: ["235M online", "58% on Java", "IDR 1,000T"],
  },
  { id: "02", title: "The right channel", body: quote },
  { id: "03", title: "Who shapes the rules", body: note },
];
---

<section class="vision wrap" id="services">
  <header class="vision-head">
    <p class="vision-kicker">{kicker}</p>
    <h2 class="vision-title">
      {headline.map((line) => (
        <span>{line}</span>
      ))}
    </h2>
  </header>

  <div class="vision-bento">
    {
      insights.map((item) => (
        <article class:list={["vision-card", { "is-featured": item.featured }]}>
          <p class="vision-index">{item.id}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
          {item.metrics && (
            <ul class="vision-metrics">
              {item.metrics.map((metric) => (
                <li>{metric}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>

  <div class="vision-marquee">
    <p class="vision-marquee-label">{marqueeLabel}</p>
    <div class="vision-marquee-mask">
      {
        marqueeRows.map((row) => (
          <div class:list={["vision-row", row.reverse && "is-reverse"]}>
            <div class="vision-track">
              {[...row.items, ...row.items, ...row.items].map((item) =>
                item.kind === "text" ? (
                  <span class="vision-word">{item.value}</span>
                ) : (
                  <span class:list={["vision-pill", `is-${item.tone}`]}>
                    {item.label}
                  </span>
                ),
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .vision {
    padding: 176px 0 184px;
    font-family: "Sora", var(--sans);
    color: rgb(39, 38, 102);
  }

  .vision-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .vision-kicker {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7e7bb5;
  }

  .vision-title {
    margin: 0;
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: #272666;
  }

  .vision-title span {
    display: block;
  }

  .vision-bento {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    grid-template-rows: auto auto;
    gap: 16px;
    margin-bottom: 96px;
  }

  .vision-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 24px 26px;
    border-radius: 24px;
    background: #f6f6fa;
  }

  .vision-card.is-featured {
    grid-row: 1 / span 2;
    padding: 28px 28px 32px;
    background: #1f1c4a;
    color: #fff;
  }

  .vision-index {
    margin: 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #93d4cc;
  }

  .vision-card:not(.is-featured) .vision-index {
    color: #7e7bb5;
  }

  .vision-card h3 {
    margin: 0;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .vision-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: -0.02em;
    color: #5c5a88;
  }

  .vision-card.is-featured p:last-of-type {
    color: #adacc3;
    max-width: 46ch;
  }

  .vision-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .vision-metrics li {
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .vision-marquee-label {
    margin: 0 0 28px;
    font-size: clamp(13px, 1.2vw, 15px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(116, 113, 152);
  }

  .vision-marquee-mask {
    display: grid;
    gap: 18px;
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      #000 8%,
      #000 92%,
      transparent 100%
    );
  }

  .vision-row {
    overflow: hidden;
  }

  .vision-track {
    display: flex;
    align-items: center;
    gap: 20px;
    width: max-content;
    animation: vision-scroll 36s linear infinite;
  }

  .vision-row.is-reverse .vision-track {
    animation-direction: reverse;
  }

  .vision-word {
    font-size: clamp(32px, 5.5vw, 68px);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    white-space: nowrap;
    color: rgb(39, 38, 102);
  }

  .vision-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 72px;
    height: 72px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgb(39, 38, 102);
  }

  .vision-pill.is-purple {
    background: rgb(144, 138, 194);
    border-radius: 32px;
  }

  .vision-pill.is-yellow {
    background: rgb(251, 220, 94);
  }

  .vision-pill.is-mint {
    background: rgb(147, 212, 204);
    border-radius: 32px;
  }

  @keyframes vision-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.333%);
    }
  }

  @media (max-width: 720px) {
    .vision {
      padding: 104px 0 120px;
    }

    .vision-head {
      max-width: none;
      margin-bottom: 28px;
    }

    .vision-bento {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      margin-bottom: 48px;
    }

    .vision-card.is-featured {
      grid-row: auto;
    }

    .vision-marquee-mask {
      gap: 14px;
    }

    .vision-pill {
      min-width: 56px;
      height: 56px;
      padding: 0 16px;
      font-size: 12px;
    }
  }
</style>
