---
import Header from "./Header.astro";
import HeroSignalFunnel from "./HeroSignalFunnel.astro";
import { agency } from "../data/creators";

const logos = [
  { src: "/hero/logo1.png", w: 168 },
  { src: "/hero/logo2.png", w: 132 },
  { src: "/hero/logo3.png", w: 128 },
  { src: "/hero/logo4.png", w: 148 },
];
---

<section class="hero" id="hero">
  <Header />
  <HeroSignalFunnel />

  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">{agency.hero.eyebrow}</p>
      <h1>{agency.hero.headline}</h1>
      <p class="hero-sub">{agency.hero.subheadline}</p>

      <div class="hero-actions">
        <a class="hero-cta" href="#why">
          <span class="hero-cta-fill"></span>
          <span class="hero-cta-shine"></span>
          <span class="hero-cta-label">{agency.hero.cta}</span>
          <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true">
            <path
              d="M13.476 9.166 9.006 4.696 10.185 3.518 16.666 10 10.185 16.481 9.006 15.303 13.476 10.833 3.333 10.833 3.333 9.166 Z"
              fill="currentColor"></path>
          </svg>
        </a>

        <a class="hero-talk" href="#why">Let's talk!</a>
      </div>

      <div class="hero-logos" aria-hidden="true">
        <div class="hero-logos-track">
          {[...logos, ...logos].map((logo) => (
            <img src={logo.src} alt="" style={`width:${logo.w}px`} />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --muted: #aeacc3;
    --cta-ink: #282560;
    --hero-gutter: 56px;
    --hero-h: 100vh;
    --hero-h: 100dvh;
    position: relative;
    width: 100%;
    height: var(--hero-h);
    min-height: var(--hero-h);
    padding: 0;
    margin: 0;
    overflow: hidden;
    color: #fff;
    background: #282560;
    font-family: "Sora", var(--sans);
  }

  .hero :global(.site-header) {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    color: #fff;
    background: transparent;
    backdrop-filter: none;
    border: 0;
    padding: 28px var(--hero-gutter) 14px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero :global(.site-header.is-on-light) {
    color: var(--ink);
    background: #fff;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(17, 18, 18, 0.08);
  }

  .hero :global(.site-header.is-on-light .wordmark) {
    color: var(--ink);
  }

  .hero :global(.site-header.is-on-light .site-nav a) {
    color: rgba(17, 18, 18, 0.75);
  }

  .hero :global(.site-header.is-on-light .site-nav a:hover) {
    color: var(--ink);
  }

  .hero :global(.site-header.is-on-light .menu-trigger) {
    color: var(--ink);
    border-color: rgba(17, 18, 18, 0.2);
    background: var(--paper);
  }

  @media (max-width: 1100px) {
    .hero :global(.site-header .menu-trigger),
    .hero :global(.site-header.is-on-light .menu-trigger) {
      border: none;
      background: transparent;
    }
  }

  .hero :global(.site-header.is-on-light .menu-trigger-bars span) {
    background: var(--ink);
  }

  .hero :global(.wordmark) {
    color: #fff;
  }

  .hero-inner {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    width: 100%;
    height: 100%;
    padding: 120px var(--hero-gutter) 96px;
    box-sizing: border-box;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 640px;
    min-width: 0;
  }

  .hero-eyebrow {
    margin: 0 0 18px;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--muted);
  }

  h1 {
    margin: 0 0 22px;
    max-width: 16ch;
    font-size: clamp(34px, 3.65vw, 48px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .hero-sub {
    margin: 0 0 36px;
    max-width: 52ch;
    font-size: clamp(14px, 1.2vw, 16px);
    overflow-wrap: break-word;
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px 28px;
  }

  .hero-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 56px;
    padding: 0 26px 0 28px;
    border-radius: 100px;
    color: var(--cta-ink);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.03em;
    background: linear-gradient(180deg, #fbe073 0%, #f9d12d 100%);
    box-shadow:
      rgb(244, 193, 0) 0 0 0 1.5px,
      rgba(0, 0, 0, 0.12) 0 4px 4px;
    overflow: hidden;
  }

  .hero-cta-fill,
  .hero-cta-shine {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .hero-cta-shine {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 55%);
  }

  .hero-cta-label,
  .hero-cta svg {
    position: relative;
    z-index: 1;
  }

  .hero-talk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 0 26px;
    border: 1.5px solid rgba(255, 255, 255, 0.85);
    border-radius: 100px;
    color: #fff;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.03em;
    background: transparent;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .hero-talk:hover {
    background: #fff;
    border-color: #fff;
    color: var(--cta-ink);
  }

  .hero-logos {
    position: relative;
    z-index: 4;
    width: 100%;
    margin-top: 32px;
    padding-top: 0;
    mask-image: linear-gradient(90deg, #000 0%, #000 70%, transparent 100%);
  }

  .hero-logos-track {
    display: flex;
    align-items: center;
    gap: 28px;
    width: max-content;
    animation: logos 28s linear infinite;
  }

  .hero-logos img {
    height: 28px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.72;
  }

  @keyframes logos {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 1100px) {
    .hero {
      --hero-gutter: 24px;
    }

    .hero :global(.site-header) {
      padding: 20px var(--hero-gutter) 14px;
    }

    .hero-inner {
      justify-content: flex-end;
      padding: 72px var(--hero-gutter) 32px;
    }

    .hero-copy {
      max-width: 100%;
    }

    .hero-eyebrow {
      font-size: clamp(14px, 3.6vw, 18px);
      line-height: 1.35;
    }

    h1 {
      max-width: none;
      font-size: clamp(22px, 6vw, 31px);
      line-height: 1.16;
      letter-spacing: -0.03em;
    }

    .hero-sub {
      max-width: none;
      font-size: clamp(13px, 3.5vw, 15px);
      line-height: 1.5;
    }

    .hero-actions {
      gap: 14px 16px;
    }

    .hero-cta,
    .hero-talk {
      width: 100%;
      justify-content: center;
    }

    .hero-logos {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .hero-inner {
      justify-content: flex-end;
      padding-bottom: 36px;
    }
  }
</style>

<script>
  function fitHeroToScreen() {
    const hero = document.getElementById("hero");
    if (!hero) return;
    const height = Math.round(window.visualViewport?.height ?? window.innerHeight);
    hero.style.setProperty("--hero-h", `${height}px`);
    hero.style.height = `${height}px`;
  }

  fitHeroToScreen();
  window.addEventListener("resize", fitHeroToScreen);
  window.visualViewport?.addEventListener("resize", fitHeroToScreen);

  const header = document.querySelector("#hero .site-header");
  const lightSections = new Set(["about", "services", "impact", "why", "faq"]);

  function onScroll() {
    if (!header) return;
    const probe = header.getBoundingClientRect().bottom + 12;
    const section = [...document.querySelectorAll("main > section")].find((el) => {
      const box = el.getBoundingClientRect();
      return box.top <= probe && box.bottom > probe;
    });
    header.classList.toggle("is-on-light", lightSections.has(section?.id ?? ""));
  }

  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
