---
import { agency } from "../data/creators";

const links = [
  { href: "/", label: "home" },
  { href: "/#services", label: "work" },
  { href: "/#services", label: "services" },
  { href: "/#about", label: "about us" },
  { href: "/network", label: "our network" },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${agency.name} home`}>
    {agency.name}
  </a>

  <nav class="site-nav" aria-label="Primary">
    {links.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a class="nav-lets-talk" href="/#why">Let's talk!</a>
  </nav>

  <button
    class="menu-trigger"
    type="button"
    data-menu-open
    aria-expanded="false"
    aria-controls="site-menu"
    aria-label="Open menu"
  >
    <span class="menu-trigger-label">MENU</span>
    <span class="menu-trigger-bars" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>
</header>

<script>
  function bindInnerHeaderScroll() {
    const header = document.querySelector(".site-header");
    if (!(header instanceof HTMLElement) || header.closest("#hero")) return;
    if (header.dataset.scrollBound === "1") return;
    header.dataset.scrollBound = "1";

    const sync = () => {
      const probe = header.getBoundingClientRect().bottom + 12;
      const cta = document.getElementById("cta");
      const overFooter = Boolean(
        cta &&
          cta.getBoundingClientRect().top <= probe &&
          cta.getBoundingClientRect().bottom > probe,
      );

      header.classList.toggle("is-over-footer", overFooter);
      header.classList.toggle("is-on-light", !overFooter && window.scrollY > 24);
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
  }

  bindInnerHeaderScroll();
  document.addEventListener("astro:page-load", bindInnerHeaderScroll);
</script>
