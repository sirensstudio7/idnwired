---
export const prerender = true;

import CtaBanner from "../components/CtaBanner.astro";
import Header from "../components/Header.astro";
import MenuOverlay from "../components/MenuOverlay.astro";
import { mediaNetwork, mediaNetworkMeta } from "../data/media-network";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${mediaNetworkMeta.title} — IDNWIRED`}
  description={mediaNetworkMeta.description}
  bodyClass="page-network"
>
  <MenuOverlay />
  <Header />

  <main class="network-page">
    <div class="network-page__inner wrap" data-network-root>
      <div class="network-page__intro">
        <header class="network-page__head">
          <h1>{mediaNetworkMeta.title}</h1>
          <p>{mediaNetworkMeta.description}</p>
        </header>

        <div class="network-tools" role="search">
        <label class="network-search">
          <span class="sr-only">Search network</span>
          <span class="network-search__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
              <circle
                cx="8.75"
                cy="8.75"
                r="5.5"
                stroke="currentColor"
                stroke-width="1.75"></circle>
              <path
                d="M13.25 13.25 17 17"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"></path>
            </svg>
          </span>
          <input
            type="search"
            name="outlet-search"
            placeholder="Search network…"
            autocomplete="off"
            spellcheck="false"
            data-network-search
          />
        </label>

        <div class="network-filter" data-network-category-dropdown>
          <button
            type="button"
            class="network-filter-trigger"
            data-network-category-trigger
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="network-category-listbox"
          >
            <span class="network-filter-trigger__label" data-network-category-label>
              All categories
            </span>
            <span class="network-filter-trigger__icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                <path
                  d="M5 7.5 10 12.5 15 7.5"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </span>
          </button>
          <button
            type="button"
            class="network-filter-clear"
            data-network-category-clear
            hidden
            aria-label="Reset to all categories"
          >
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M5 5 15 15M15 5 5 15"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"></path>
            </svg>
          </button>
          <ul
            id="network-category-listbox"
            class="network-filter-menu"
            role="listbox"
            aria-label="Filter by category"
            data-network-category-menu
            hidden
          >
            <li role="presentation">
              <button
                type="button"
                role="option"
                class="network-filter-option is-selected"
                data-network-category-option="all"
                aria-selected="true"
              >
                All categories
              </button>
            </li>
            {
              mediaNetwork.map((category) => (
                <li role="presentation">
                  <button
                    type="button"
                    role="option"
                    class="network-filter-option"
                    data-network-category-option={category.id}
                    aria-selected="false"
                  >
                    {category.title}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
        </div>
      </div>

      <div class="network-list" data-network-list>
      <p class="network-empty" data-network-empty hidden>
        No outlets match your search. Try another name or category.
      </p>
      {
        mediaNetwork.map((category) => (
          <section
            class="network-category"
            aria-labelledby={`cat-${category.id}`}
            data-network-category-section={category.id}
          >
            <h2 id={`cat-${category.id}`} class="network-category__title">
              {category.title}
            </h2>
            <ul class="network-outlets">
              {category.outlets.map((outlet) => (
                <li data-outlet-name={outlet.name}>
                  {outlet.href ? (
                    <a
                      href={outlet.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {outlet.name}
                    </a>
                  ) : (
                    <span>{outlet.name}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      </div>
    </div>
  </main>
  <CtaBanner />
</BaseLayout>

<script>
  import { initNetworkFilter } from "../scripts/network-filter";

  initNetworkFilter();
  document.addEventListener("astro:page-load", initNetworkFilter);
</script>

<style>
  .network-page {
    margin: 0;
    scroll-margin-top: 88px;
    padding: 176px 0 184px;
    font-family: "Sora", var(--sans);
    color: rgb(39, 38, 102);
    background: #fff;
  }

  .network-page__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .network-page__intro {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 56px;
  }

  .network-page__head {
    margin: 0;
    max-width: 720px;
  }

  .network-page__head h1 {
    margin: 0 0 12px;
    font-size: clamp(28px, 3.2vw, 36px);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .network-page__head p {
    margin: 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.6;
    color: #747198;
  }

  .network-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    width: 100%;
    margin: 0;
  }

  .network-search {
    position: relative;
    display: block;
    flex: 1 1 220px;
    min-width: 0;
    max-width: min(420px, 100%);
  }

  .network-search__icon {
    position: absolute;
    top: 50%;
    left: 14px;
    display: flex;
    color: #9a97b8;
    pointer-events: none;
    transform: translateY(-50%);
  }

  .network-search input {
    width: 100%;
    margin: 0;
    padding: 12px 16px 12px 42px;
    border: 1px solid rgba(39, 38, 102, 0.14);
    border-radius: 10px;
    background: #fff;
    font-family: "Sora", var(--sans);
    font-size: 15px;
    letter-spacing: -0.02em;
    color: #272666;
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .network-search input::placeholder {
    color: #9a97b8;
  }

  .network-search input:hover {
    border-color: rgba(39, 38, 102, 0.22);
  }

  .network-search input:focus-visible {
    border-color: rgba(39, 38, 102, 0.35);
    box-shadow: 0 0 0 3px rgba(126, 123, 181, 0.2);
  }

  .network-filter {
    position: relative;
    flex: 0 1 280px;
    width: min(280px, 100%);
    margin-left: auto;
  }

  .network-filter-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 12px 14px 12px 16px;
    border: 1px solid rgba(39, 38, 102, 0.14);
    border-radius: 10px;
    background: #fff;
    font-family: "Sora", var(--sans);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #272666;
    text-align: left;
    cursor: pointer;
    outline: none;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .network-filter-trigger.is-filtered {
    padding-right: 42px;
  }

  .network-filter-trigger.is-filtered .network-filter-trigger__icon {
    display: none;
  }

  .network-filter-clear {
    position: absolute;
    top: 50%;
    right: 10px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #747198;
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background 0.12s ease,
      color 0.12s ease;
  }

  .network-filter-clear[hidden] {
    display: none;
  }

  .network-filter-clear svg {
    display: block;
  }

  .network-filter-clear:hover {
    background: rgba(39, 38, 102, 0.08);
    color: #272666;
  }

  .network-filter-clear:focus-visible {
    outline: 2px solid rgba(126, 123, 181, 0.55);
    outline-offset: 1px;
  }

  .network-filter-trigger__label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .network-filter-trigger__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    line-height: 0;
    color: #747198;
  }

  .network-filter-trigger__icon svg {
    display: block;
    transition: transform 0.15s ease;
  }

  .network-filter.is-open .network-filter-trigger__icon svg {
    transform: rotate(180deg);
  }

  .network-filter-trigger:hover {
    border-color: rgba(39, 38, 102, 0.22);
  }

  .network-filter-trigger:focus-visible,
  .network-filter.is-open .network-filter-trigger {
    border-color: rgba(39, 38, 102, 0.35);
    box-shadow: 0 0 0 3px rgba(126, 123, 181, 0.2);
  }

  .network-filter-menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    max-height: min(320px, 50vh);
    margin: 0;
    padding: 6px;
    overflow: auto;
    list-style: none;
    border: 1px solid rgba(39, 38, 102, 0.12);
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 12px 40px rgba(39, 38, 102, 0.12),
      0 2px 8px rgba(17, 18, 18, 0.06);
  }

  .network-filter-menu[hidden] {
    display: none;
  }

  .network-filter-option {
    display: block;
    width: 100%;
    margin: 0;
    padding: 10px 12px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font-family: "Sora", var(--sans);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: #272666;
    text-align: left;
    cursor: pointer;
    transition: background 0.12s ease;
  }

  .network-filter-option:hover {
    background: rgba(39, 38, 102, 0.06);
  }

  .network-filter-option.is-selected,
  .network-filter-option[aria-selected="true"] {
    background: rgba(39, 38, 102, 0.08);
    font-weight: 500;
    color: #1a1a4a;
  }

  .network-filter-option:focus-visible {
    outline: 2px solid rgba(126, 123, 181, 0.55);
    outline-offset: -2px;
  }

  .network-list {
    margin: 0;
  }

  .network-empty {
    margin: 0 0 32px;
    font-size: 15px;
    line-height: 1.5;
    color: #747198;
  }

  .network-empty[hidden] {
    display: none;
  }

  .network-category.is-filtered-out {
    display: none;
  }

  .network-outlets li.is-filtered-out {
    display: none;
  }

  .network-category {
    margin-bottom: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(17, 18, 18, 0.08);
  }

  .network-category:last-of-type {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .network-category__title {
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #7e7bb5;
  }

  .network-outlets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .network-outlets li {
    min-width: 0;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: #272666;
  }

  .network-outlets a {
    color: #272666;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(40, 37, 96, 0.35);
  }

  .network-outlets a:hover {
    color: #1a1a4a;
    text-decoration-color: currentColor;
  }

  @media (max-width: 980px) {
    .network-page {
      padding: 104px 0 120px;
    }

    .network-page__intro {
      gap: 20px;
      margin-bottom: 40px;
    }

    .network-page__head {
      max-width: none;
    }

    .network-tools {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .network-search {
      flex: 1 1 auto;
      max-width: none;
    }

    .network-filter {
      flex: 1 1 auto;
      width: 100%;
      margin-left: 0;
    }

    .network-outlets {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 20px;
    }
  }

  @media (max-width: 640px) {
    .network-outlets {
      grid-template-columns: 1fr;
    }

    .network-outlets li {
      font-size: 14px;
    }
  }
</style>
