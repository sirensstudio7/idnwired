---
import FolderCard from "../../components/FolderCard.astro";
import Header from "../../components/Header.astro";
import MenuOverlay from "../../components/MenuOverlay.astro";
import SelectionBox from "../../components/SelectionBox.astro";
import { agency, creators, getCreator } from "../../data/creators";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return creators.map((creator) => ({
    params: { slug: creator.slug },
  }));
}

const { slug } = Astro.params;
const creator = getCreator(slug!);

if (!creator) {
  throw new Error(`Unknown creator: ${slug}`);
}
---

<BaseLayout
  title={`${creator.name} — IDNWIRED`}
  description={creator.blurb}
>
  <Header />
  <MenuOverlay />
  <main class="profile wrap">
    <a class="back mono" href="/#services">← BACK TO SERVICES</a>
    <p class="script intro">meet</p>
    <h1 class="display">
      <SelectionBox>{creator.name}</SelectionBox>
    </h1>
    <p class="status-line">
      <span class="status-dot" aria-hidden="true"></span>
      {creator.handle} · {creator.followerLabel} · {creator.location}
    </p>
    <p class="tagline">{creator.blurb}</p>
    <div class="chip-row">
      {creator.platforms.map((platform) => (
        <span class="chip is-cyan">{platform}</span>
      ))}
      <span class="chip is-pink">{creator.role}</span>
    </div>

    <div class="bio-block">
      <div class="frame portrait">
        <span class="frame-handle tl"></span>
        <span class="frame-handle tr"></span>
        <span class="frame-handle bl"></span>
        <span class="frame-handle br"></span>
        <span class="frame-label">IMAGE.JPG</span>
        <img src={creator.cover} alt={`${creator.name} cover`} />
      </div>
      <div>
        <h2 class="script">what's up</h2>
        <p class="bio">{creator.bio}</p>
        <a class="cta" href={`mailto:${agency.email}?subject=Book ${creator.name}`}>
          <span class="cta-icon" aria-hidden="true">&gt;&gt;</span>
          <span class="cta-label">BOOK {creator.name.split(" ")[0].toUpperCase()}</span>
        </a>
      </div>
    </div>

    <p class="script series-scribble">featured series</p>
    <h2 class="display series-title">On the slate</h2>
    <div class="series-list">
      {creator.series.map((item, index) => (
        <FolderCard
          index={index + 1}
          name={item.title}
          date={item.date}
          blurb={item.blurb}
          href="#contact"
          tags={[item.tag]}
          cover={creator.cover}
          accent={creator.accent}
          cta="INQUIRE"
          flip={index % 2 === 1}
        />
      ))}
    </div>

    <section class="close" id="contact">
      <h2 class="display">Let's Talk</h2>
      <p>{agency.contactNote}</p>
      <a class="cta" href={`mailto:${agency.email}`}>
        <span class="cta-icon" aria-hidden="true">&gt;&gt;</span>
        <span class="cta-label">CONTACT US</span>
      </a>
    </section>
  </main>
</BaseLayout>

<style>
  .profile {
    padding: 36px 0 90px;
    text-align: center;
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 12px;
  }

  .intro {
    margin: 0 0 12px;
    font-size: 28px;
  }

  h1 {
    margin: 0 0 18px;
    max-width: 100%;
    font-size: clamp(36px, 10vw, 140px);
  }

  .tagline {
    margin: 16px auto 22px;
    max-width: 28ch;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
  }

  .chip-row {
    justify-content: center;
    margin-bottom: 48px;
  }

  .bio-block {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 32px;
    text-align: left;
    align-items: center;
    margin-bottom: 64px;
  }

  .portrait {
    aspect-ratio: 4 / 3;
  }

  .bio-block h2 {
    margin: 0 0 12px;
    font-size: 28px;
  }

  .bio {
    margin: 0 0 22px;
    font-size: 18px;
    line-height: 1.45;
  }

  .series-scribble {
    margin: 0 0 8px;
    font-size: 26px;
  }

  .series-title {
    margin: 0 0 28px;
    font-size: clamp(40px, 7vw, 64px);
  }

  .series-list {
    display: grid;
    gap: 24px;
    text-align: left;
  }

  .close {
    margin-top: 72px;
  }

  .close h2 {
    margin: 0 0 12px;
    font-size: clamp(40px, 8vw, 72px);
  }

  .close p {
    margin: 0 auto 22px;
    max-width: 42ch;
  }

  @media (max-width: 1100px) {
    .bio-block {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 800px) {
    .profile {
      padding: 24px 0 64px;
    }

    .tagline {
      font-size: 18px;
    }

    .close h2,
    .series-title {
      font-size: clamp(32px, 10vw, 48px);
    }
  }
</style>
