---
export const prerender = false;

import AdminShell from "../../components/admin/AdminShell.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { INQUIRY_STATUSES, type InquiryStatus } from "../../lib/inquiries/schema";
import { requireAdminUser } from "../../lib/supabase/server";

const { supabase, user } = await requireAdminUser(Astro.cookies);
if (!user) {
  return Astro.redirect("/admin/login");
}

const statusFilter = Astro.url.searchParams.get("status") ?? "all";
const allowed = new Set(["all", ...INQUIRY_STATUSES]);
const filter = allowed.has(statusFilter) ? statusFilter : "all";

function adminListHref(statusId: string) {
  if (statusId === "all") return "/admin";
  return `/admin?status=${statusId}`;
}

const { data: allForCounts } = await supabase.from("project_inquiries").select("status");

const counts: Record<string, number> = {
  all: allForCounts?.length ?? 0,
  new: 0,
  contacted: 0,
  closed: 0,
};
for (const row of allForCounts ?? []) {
  const s = row.status as InquiryStatus;
  if (s in counts) counts[s]++;
}

let query = supabase
  .from("project_inquiries")
  .select("id, created_at, status, company_name, contact_name, email")
  .order("created_at", { ascending: false });

if (filter !== "all") {
  query = query.eq("status", filter);
}

const { data: inquiries, error } = await query;

const pageTitle =
  filter === "all" ? "Inbox" : filter.charAt(0).toUpperCase() + filter.slice(1);

const filterItems = [
  { id: "all", label: "All", href: adminListHref("all") },
  ...INQUIRY_STATUSES.map((s) => ({
    id: s,
    label: s.charAt(0).toUpperCase() + s.slice(1),
    href: adminListHref(s),
  })),
];

const statusOptions = [
  { value: "all", label: "All statuses" },
  ...INQUIRY_STATUSES.map((s) => ({
    value: s,
    label: s.charAt(0).toUpperCase() + s.slice(1),
  })),
];

const statusLabel =
  statusOptions.find((o) => o.value === filter)?.label ?? "All statuses";

function companyInitial(name: string) {
  const trimmed = name.trim();
  return trimmed ? trimmed.charAt(0).toUpperCase() : "?";
}

function formatRelative(iso: string) {
  const d = new Date(iso);
  const now = new Date();
  const diffMs = now.getTime() - d.getTime();
  const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
  if (diffDays === 0) {
    return new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
    }).format(d);
  }
  if (diffDays < 7) {
    return new Intl.DateTimeFormat("en-GB", { weekday: "short" }).format(d);
  }
  return new Intl.DateTimeFormat("en-GB", {
    day: "numeric",
    month: "short",
  }).format(d);
}
---

<AdminLayout title={pageTitle}>
  <AdminShell statusFilter={filter} userEmail={user.email} counts={counts}>
    {
      error ? (
        <div class="admin-notice admin-notice--error" role="alert">
          Could not load inquiries. Check Supabase connection and RLS policies.
        </div>
      ) : null
    }

    <header class="admin-page-head">
      <h1>{pageTitle}</h1>
      <p class="admin-page-head__desc">Campaign briefs submitted from the website.</p>
    </header>

    <div class="admin-stat-grid" aria-label="Summary">
      {
        filterItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "admin-stat-card",
              `admin-stat-card--${item.id}`,
              filter === item.id && "is-active",
            ]}
            aria-current={filter === item.id ? "page" : undefined}
          >
            <span class="admin-stat-card__value">{counts[item.id] ?? 0}</span>
            <span class="admin-stat-card__label">{item.label}</span>
          </a>
        ))
      }
    </div>

    <div class="admin-list-toolbar">
      <div class="admin-list-toolbar__search">
        <label class="admin-sr-only" for="lead-search">Search inquiries</label>
        <svg class="admin-list-toolbar__icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M13.5 13.5 17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
        <input
          id="lead-search"
          type="search"
          placeholder="Search company, contact, or email"
          autocomplete="off"
        />
      </div>
      <form class="admin-list-toolbar__filter" method="get" action="/admin">
        <div class="admin-custom-select" data-admin-custom-select>
          <label class="admin-sr-only" for="lead-status-trigger">Status</label>
          <input type="hidden" name="status" value={filter} data-status-input />
          <button
            type="button"
            class="admin-custom-select__trigger"
            id="lead-status-trigger"
            aria-haspopup="listbox"
            aria-expanded="false"
          >
            <span data-status-label>{statusLabel}</span>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M6 8l4 4 4-4"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul class="admin-custom-select__menu" role="listbox" aria-label="Status" hidden>
            {
              statusOptions.map((opt) => (
                <li role="presentation">
                  <button
                    type="button"
                    class="admin-custom-select__option"
                    role="option"
                    data-value={opt.value}
                    aria-selected={filter === opt.value}
                  >
                    {opt.label}
                  </button>
                </li>
              ))
            }
          </ul>
        </div>
      </form>
    </div>

    {
      inquiries && inquiries.length === 0 ? (
        <div class="admin-card admin-empty">
          <p>No inquiries in this view.</p>
        </div>
      ) : (
        <>
          <p id="lead-search-empty" class="admin-card admin-empty" hidden>
            No inquiries match your search.
          </p>
          <ul class="admin-lead-cards" aria-label="Inquiry list">
          {
            inquiries?.map((row) => (
              <li
                data-search={`${row.company_name} ${row.contact_name} ${row.email}`.toLowerCase()}
              >
                <a class="admin-lead-card" href={`/admin/inquiries/${row.id}`}>
                  <span
                    class:list={[
                      "admin-lead-card__mark",
                      `admin-lead-card__mark--${row.status}`,
                    ]}
                    aria-hidden="true"
                  >
                    {companyInitial(row.company_name)}
                  </span>
                  <div class="admin-lead-card__content">
                    <div class="admin-lead-card__row">
                      <span class="admin-lead-card__company">{row.company_name}</span>
                      <time class="admin-lead-card__time" datetime={row.created_at}>
                        {formatRelative(row.created_at)}
                      </time>
                    </div>
                    <div class="admin-lead-card__row admin-lead-card__row--sub">
                      <span class="admin-lead-card__meta">
                        <span class="admin-lead-card__contact">{row.contact_name}</span>
                        <span class="admin-lead-card__sep" aria-hidden="true">·</span>
                        <span class="admin-lead-card__email">{row.email}</span>
                      </span>
                      <span class={`admin-badge admin-badge--${row.status}`}>{row.status}</span>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
          </ul>
        </>
      )
    }

    <script>
      function initAdminCustomSelect(root: Element, form: HTMLFormElement) {
        const trigger = root.querySelector(".admin-custom-select__trigger") as HTMLButtonElement | null;
        const menu = root.querySelector(".admin-custom-select__menu") as HTMLUListElement | null;
        const hidden = root.querySelector("[data-status-input]") as HTMLInputElement | null;
        const label = root.querySelector("[data-status-label]");
        const options = root.querySelectorAll(".admin-custom-select__option");
        if (!trigger || !menu || !hidden) return;

        const close = () => {
          menu.hidden = true;
          trigger.setAttribute("aria-expanded", "false");
        };

        const open = () => {
          menu.hidden = false;
          trigger.setAttribute("aria-expanded", "true");
        };

        trigger.addEventListener("click", () => {
          if (menu.hidden) open();
          else close();
        });

        options.forEach((opt) => {
          opt.addEventListener("click", () => {
            const value = opt.getAttribute("data-value") ?? "all";
            const text = opt.textContent?.trim() ?? "";
            hidden.value = value;
            if (label) label.textContent = text;
            options.forEach((o) =>
              o.setAttribute("aria-selected", o === opt ? "true" : "false"),
            );
            close();
            form.requestSubmit();
          });
        });

        document.addEventListener("click", (event) => {
          if (!root.contains(event.target as Node)) close();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") close();
        });
      }

      function initLeadListToolbar() {
        const toolbar = document.querySelector(".admin-list-toolbar");
        if (!toolbar || toolbar.dataset.bound === "1") return;
        toolbar.dataset.bound = "1";

        const input = document.getElementById("lead-search") as HTMLInputElement | null;
        const list = document.querySelector(".admin-lead-cards");
        const emptyMsg = document.getElementById("lead-search-empty");
        const statusForm = document.querySelector(
          ".admin-list-toolbar__filter",
        ) as HTMLFormElement | null;
        const customSelect = toolbar.querySelector("[data-admin-custom-select]");
        if (customSelect && statusForm) {
          initAdminCustomSelect(customSelect, statusForm);
        }

        if (!input || !list) return;

        const items = list.querySelectorAll("li");

        const applySearch = () => {
          const q = input.value.trim().toLowerCase();
          let visible = 0;
          items.forEach((li) => {
            const haystack = li.getAttribute("data-search") ?? "";
            const show = !q || haystack.includes(q);
            (li as HTMLElement).hidden = !show;
            if (show) visible += 1;
          });
          if (emptyMsg) emptyMsg.hidden = visible > 0;
        };

        input.addEventListener("input", applySearch);
        input.addEventListener("search", applySearch);
        input.addEventListener("keydown", (event) => {
          if (event.key === "Enter") event.preventDefault();
        });
      }

      initLeadListToolbar();
      document.addEventListener("astro:page-load", initLeadListToolbar);
    </script>
  </AdminShell>
</AdminLayout>
