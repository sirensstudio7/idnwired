---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";

const supabase = createSupabaseServerClient(Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();

if (user) {
  return Astro.redirect("/admin");
}

const cases = [
  {
    title: "Inbox",
    text: "Briefs from the public form land here with company, city, and notes.",
  },
  {
    title: "Articles",
    text: "Draft, SEO, and publish stories to the wire in one desk.",
  },
  {
    title: "Status",
    text: "Move leads from new to contacted to closed so the team stays aligned.",
  },
];
---

<AdminLayout title="Sign in">
  <div class="admin-login" data-login>
    <div class="admin-login__wash" aria-hidden="true"></div>

    <div class="admin-login__shell">
      <section class="admin-login__panel">
        <div class="admin-login__panel-inner">
          <div class="admin-login__main">
            <a class="admin-login__logo" href="/" aria-label="IDNWIRED home">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="40" height="40" fill="none" aria-hidden="true">
                <path d="M4 23c6-8 18-8 24 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
                <path d="M7 17c5-6.5 13-6.5 18 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
                <path d="M10 11c3.4-4.2 8.6-4.2 12 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
              </svg>
            </a>

            <form class="admin-login__form" id="admin-login-form" novalidate>
              <div class="admin-login__pane" data-login-pane="email">
                <h1>Sign in</h1>
                <div class="admin-login__control">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path>
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  </svg>
                  <label class="admin-sr-only" for="admin-login-email">Email</label>
                  <input
                    id="admin-login-email"
                    type="email"
                    name="email"
                    inputmode="email"
                    autocomplete="username"
                    enterkeyhint="go"
                    placeholder="your@email.com"
                    required
                    autofocus
                  />
                </div>
              </div>

              <div class="admin-login__pane" data-login-pane="password" hidden>
                <h1>Enter password</h1>
                <p class="admin-login__hint">
                  Continue as <span data-login-email-label></span>
                </p>
                <div class="admin-login__control">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  <label class="admin-sr-only" for="admin-login-password">Password</label>
                  <input
                    id="admin-login-password"
                    type="password"
                    name="password"
                    autocomplete="current-password"
                    placeholder="Password"
                    required
                    data-login-password
                  />
                  <button
                    type="button"
                    class="admin-login__reveal"
                    data-login-reveal
                    aria-label="Show password"
                    aria-pressed="false"
                    aria-controls="admin-login-password"
                  >
                    Show
                  </button>
                </div>
              </div>

              <p class="admin-login__error" id="admin-login-error" hidden></p>
              <button type="submit" class="admin-login__submit" data-login-submit>Get started</button>
              <button type="button" class="admin-login__back" data-login-back hidden>Use a different email</button>
            </form>
          </div>

          <p class="admin-login__foot">IDNWIRED</p>
        </div>
      </section>

      <section class="admin-login__story">
        <div class="admin-login__story-copy">
          <h2>
            <span>The desk for</span>
            <span>Indonesian news</span>
          </h2>
          <p>
            Manage briefs, publish stories, and keep campaigns moving across media,
            creators, and cities.
          </p>
        </div>

        <div class="admin-login__cases">
          <p class="admin-login__cases-kicker">What’s on the desk</p>
          <div class="admin-login__case-grid">
            {
              cases.map((item) => (
                <article class="admin-login__case">
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>

<script>
  const root = document.querySelector("[data-login]");
  const form = document.getElementById("admin-login-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("admin-login-error") as HTMLParagraphElement | null;
  const emailInput = document.getElementById("admin-login-email") as HTMLInputElement | null;
  const passwordInput = form?.querySelector("[data-login-password]") as HTMLInputElement | null;
  const emailPane = form?.querySelector("[data-login-pane='email']") as HTMLElement | null;
  const passwordPane = form?.querySelector("[data-login-pane='password']") as HTMLElement | null;
  const emailLabel = form?.querySelector("[data-login-email-label]") as HTMLElement | null;
  const submit = form?.querySelector("[data-login-submit]") as HTMLButtonElement | null;
  const back = form?.querySelector("[data-login-back]") as HTMLButtonElement | null;
  const reveal = form?.querySelector("[data-login-reveal]") as HTMLButtonElement | null;
  let step: "email" | "password" = "email";

  const showError = (message: string) => {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
  };

  const hideError = () => {
    if (!errorEl) return;
    errorEl.hidden = true;
    errorEl.textContent = "";
  };

  const setStep = (next: "email" | "password") => {
    step = next;
    hideError();
    if (emailPane) emailPane.hidden = next !== "email";
    if (passwordPane) passwordPane.hidden = next !== "password";
    if (back) back.hidden = next !== "password";
    if (submit) submit.textContent = next === "email" ? "Get started" : "Sign in";
    if (next === "password") {
      if (emailLabel && emailInput) emailLabel.textContent = emailInput.value.trim();
      passwordInput?.focus();
    } else {
      emailInput?.focus();
    }
  };

  reveal?.addEventListener("click", () => {
    if (!passwordInput) return;
    const show = passwordInput.type === "password";
    passwordInput.type = show ? "text" : "password";
    reveal.textContent = show ? "Hide" : "Show";
    reveal.setAttribute("aria-pressed", show ? "true" : "false");
    reveal.setAttribute("aria-label", show ? "Hide password" : "Show password");
  });

  back?.addEventListener("click", () => {
    if (passwordInput) passwordInput.value = "";
    setStep("email");
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    hideError();

    const email = emailInput?.value.trim() ?? "";
    if (step === "email") {
      if (!email || !emailInput?.checkValidity()) {
        showError("Enter a valid email.");
        emailInput?.focus();
        return;
      }
      setStep("password");
      return;
    }

    const password = passwordInput?.value ?? "";
    if (!password) {
      showError("Enter your password.");
      passwordInput?.focus();
      return;
    }

    if (submit) submit.disabled = true;

    try {
      const res = await fetch("/api/admin/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
        credentials: "same-origin",
      });

      if (res.ok) {
        window.location.href = "/admin";
        return;
      }

      const data = (await res.json().catch(() => ({}))) as { error?: string };
      showError(data.error ?? "Sign in failed.");
    } catch {
      showError("Network error. Try again.");
    } finally {
      if (submit) submit.disabled = false;
    }
  });

  root?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && step === "password") {
      event.preventDefault();
      setStep("email");
    }
  });
</script>
